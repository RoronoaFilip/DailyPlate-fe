{
  "name": "dailyplate-phone",
  "version": "0.1.0",
  "description": "Phone web app that captures barcode photos, meals and new foods and sends them to the Daily Plate desktop app.",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:scripts": "node --test \"scripts/*.test.mjs\"",
    "fixtures:export": "tsx scripts/export-fixtures.ts",
    "fixtures:check": "tsx scripts/export-fixtures.ts --check",
    "verify": "npm run check:arch && npm run check:theme && npm run check:scripts && npm run fixtures:check && npm test && npm run build"
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "jsdom": "^30.1.2",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
